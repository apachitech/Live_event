# ==============================================================================
# PULSESTREAM PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL="https://your-app.onrender.com"

# Database Configuration (Render Managed PostgreSQL or SQLite locally)
# Local dev: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://liveuser:YOUR_POSTGRES_PASSWORD@live-stream-postgres:5432/livestreampform?sslmode=require"

# Redis / Key-Value Store (Render Redis for session caching, pub/sub & rate limiting)
REDIS_URL="redis://default:YOUR_REDIS_PASSWORD@live-stream-redis:6379"

# JSON Web Token Authentication Secret
JWT_SECRET="generate-a-strong-random-64-character-secret-key-here"

# LiveKit Cloud (Managed WebRTC SFU & RTMP Ingress)
LIVEKIT_API_KEY="your_livekit_api_key_here"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"
LIVEKIT_URL="wss://your-livekit-subdomain.livekit.cloud"

# Payment Gateways
# 1. Stripe
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# 2. CCBill (High-Risk Adult/Digital Media Processing)
CCBILL_ACCOUNT_NO="900000"
CCBILL_SUBACCOUNT_NO="0001"
CCBILL_SALT="your_ccbill_encryption_salt_here"

# 3. Flutterwave (African Mobile Money - DR Congo M-Pesa, Orange, Airtel, Afrimoney)
FLUTTERWAVE_SECRET_KEY="your_flutterwave_secret_key_here"
FLUTTERWAVE_SECRET_HASH="your_flutterwave_webhook_secret_hash_here"

# 4. Lemon Squeezy (Hosted Global Checkout & Merchant of Record)
LEMON_SQUEEZY_API_KEY="your_lemon_squeezy_api_key_here"
LEMON_SQUEEZY_STORE_ID="your_lemon_squeezy_store_id"
LEMON_SQUEEZY_WEBHOOK_SECRET="your_lemon_squeezy_webhook_secret"

# 5. NOWPayments (Cryptocurrency - BTC, ETH, USDT-TRC20, USDT-ERC20, SOL, USDC)
# Set to 'true' to use the NOWPayments test sandbox (api-sandbox.nowpayments.io)
NOWPAYMENTS_API_KEY="your_nowpayments_api_key_here"
NOWPAYMENTS_IPN_SECRET="your_nowpayments_ipn_secret_here"
NOWPAYMENTS_SANDBOX="false"

# Media Storage Provider ('local', 'r2', or 's3')
STORAGE_PROVIDER="r2"

# Cloudflare R2 / AWS S3 Storage Credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="pulsestream-vods"
R2_PUBLIC_DOMAIN="https://vods.yourplatform.com"

# External Live Video / Cloudinary Embeds (Optional)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Identity & 18+ KYC Verification (Persona / Veriff)
PERSONA_API_KEY=""
VERIFF_API_KEY=""
